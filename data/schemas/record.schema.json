{
  "$defs": {
    "Location": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "validation_status": {
          "const": "valid",
          "default": "valid",
          "title": "Validation Status",
          "type": "string"
        },
        "lineage": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Lineage",
          "type": "object"
        },
        "record_type": {
          "const": "location",
          "default": "location",
          "title": "Record Type",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "enterprise",
            "warehouse",
            "contractor",
            "field"
          ],
          "title": "Kind",
          "type": "string"
        },
        "market": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Market",
          "type": "string"
        },
        "owner_id": {
          "default": "enterprise",
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Owner Id",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "capacity_units": {
          "default": 1000000,
          "minimum": 0,
          "title": "Capacity Units",
          "type": "integer"
        },
        "transfer_enabled": {
          "default": true,
          "title": "Transfer Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source_id",
        "ingested_at",
        "name",
        "kind",
        "market"
      ],
      "title": "Location",
      "type": "object"
    },
